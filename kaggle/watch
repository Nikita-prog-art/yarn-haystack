#!/usr/bin/env bash
# Wait for a Kaggle kernel version to finish, then print its log.
#
#   kaggle/watch <owner/slug[/version]> [max_minutes]
#
# Exists because polling by hand in the foreground wastes turns: start this as a
# background job and you get told when there is actually something to read.
# Exits non-zero on ERROR/CANCEL so the caller cannot mistake a failed run for a
# successful one.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
TARGET="${1:?usage: kaggle/watch <owner/slug[/version]> [max_minutes]}"
MAXMIN="${2:-240}"
INTERVAL=60

# Status slugs observed from the CLI look like KernelWorkerStatus.RUNNING.
terminal() {
  case "$1" in
    *COMPLETE*|*ERROR*|*CANCEL*) return 0 ;;
    *) return 1 ;;
  esac
}

start=$(date +%s)
last=""
while :; do
  now=$(date +%s)
  elapsed=$(( (now - start) / 60 ))
  if [ "$elapsed" -ge "$MAXMIN" ]; then
    echo "[watch] gave up after ${MAXMIN}m; last status: ${last:-unknown}"
    exit 2
  fi
  st=$("$HERE/kg" kernels status "$TARGET" 2>&1 | tail -1)
  slug=$(printf '%s' "$st" | grep -o '"[^"]*"$' | tr -d '"')
  if [ "$slug" != "$last" ]; then
    echo "[watch] ${elapsed}m: ${slug:-$st}"
    last="$slug"
  fi
  if [ -n "$slug" ] && terminal "$slug"; then
    echo "[watch] finished as ${slug} after ${elapsed}m"
    echo "[watch] ---- results ----"
    # The log endpoint is flaky and a single fetch usually returns nothing, so let
    # from_log retry and parse. It also means the notification carries the numbers
    # instead of an empty section.
    OUTDIR="$REPO/.local/from-log-$(date +%s)"
    if "$HERE/from_log" "$TARGET" "$OUTDIR" 2>&1 | tail -8; then
      python3 - "$OUTDIR" <<'PY'
import collections, glob, json, os, sys
d = sys.argv[1]
rows = []
for path in glob.glob(os.path.join(d, "*.jsonl")):
    for line in open(path, encoding="utf-8"):
        if line.strip():
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                pass
if not rows:
    print("[watch] no rows recovered")
    raise SystemExit
agg = collections.defaultdict(lambda: [0, 0])
for r in rows:
    key = (r.get("arm") or "?", r.get("length"))
    agg[key][1] += 1
    agg[key][0] += bool(r.get("correct_word"))
print(f"[watch] recovered {len(rows)} row(s)")
for (arm, length), (ok, n) in sorted(agg.items(), key=lambda kv: (str(kv[0][0]), kv[0][1] or 0)):
    pct = 100.0 * ok / n if n else 0.0
    print(f"[watch]   {arm:<6} L={str(length):>7}: {ok}/{n}  ({pct:.0f}%)")
PY
    else
      echo "[watch] from_log could not recover results"
    fi
    case "$slug" in
      *COMPLETE*) exit 0 ;;
      *) exit 1 ;;
    esac
  fi
  sleep "$INTERVAL"
done
